{
	"name": "tezcat",
	"version": "1.1.0",
	"description": "Implements a remembrance agent for Obsidian. Look into the mirror.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --max-old-space-size=8192 node_modules/.bin/vitest run",
		"test:watch": "node --max-old-space-size=8192 node_modules/.bin/vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^20.19.9",
		"@types/sql.js": "1.4.11",
		"esbuild": "0.28.2",
		"obsidian": "1.14.4",
		"tslib": "2.9.1",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	},
	"dependencies": {
		"sql.js": "^1.8.0"
	}
}
